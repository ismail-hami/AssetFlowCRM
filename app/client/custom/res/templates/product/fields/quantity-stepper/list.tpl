<div class="input-group" style="width: 110px;">
    <span class="input-group-btn">
        <button type="button" class="btn btn-default" data-action="decreaseQty" style="padding: 2px 10px;">−</button>
    </span>
    <input type="text" class="form-control text-center" data-name="quantityInput" value="{{quantityValue}}" style="padding: 2px; height: auto;">
    <span class="input-group-btn">
        <button type="button" class="btn btn-default" data-action="increaseQty" style="padding: 2px 10px;">+</button>
    </span>
</div>