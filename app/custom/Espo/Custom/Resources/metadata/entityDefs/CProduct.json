    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "cases": {
            "type": "hasMany",
            "foreign": "cProductRequested",
            "entity": "Case",
            "audited": false,
            "isCustom": true
        },
        "category": {
            "type": "belongsTo",
            "foreign": "products",
            "entity": "CCategory",
            "audited": false,
            "isCustom": true
        }
