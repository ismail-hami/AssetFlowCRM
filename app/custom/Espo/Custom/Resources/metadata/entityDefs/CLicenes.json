{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters",
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "expiryDate": {
            "notNull": false,
            "type": "date",
            "required": false,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Expiring Soon",
                "Expired",
                "NO expiry"
            ],
            "style": {
                "Active": "success",
                "Expiring Soon": "warning",
                "Expired": "danger",
                "NO expiry": "primary"
            },
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        },
        "licenseType": {
            "type": "enum",
            "options": [
                "Perpetual",
                "Network License",
                "AnnualSubscription",
                ""
            ],
            "style": {
                "Perpetual": null,
                "Network License": null,
                "AnnualSubscription": null,
                "": null
            },
            "maxLength": 100,
            "isCustom": true
        },
        "perpetual": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "networkLicense": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "annualSubscription": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "dateDeRenouvellement": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "licenseExpires": {
            "type": "varchar",
            "required": false,
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "daysRemaining": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "options": [],
            "isCustom": true
        },
        "user": {
            "type": "varchar",
            "required": true,
            "maxLength": 100,
            "options": [],
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}