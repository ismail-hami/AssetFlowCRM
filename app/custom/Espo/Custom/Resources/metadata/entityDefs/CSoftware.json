{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "type": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "lastOrderDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "vendor": {
            "type": "enum",
            "options": [
                "ROBOBAT",
                "FREE",
                "PP",
                "HAGS"
            ],
            "style": {
                "ROBOBAT": null,
                "FREE": null,
                "PP": null,
                "HAGS": null
            },
            "default": "ROBOBAT",
            "maxLength": 100,
            "isCustom": true
        },
        "department": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "purchasePrice": {
            "type": "currency",
            "required": true,
            "isCustom": true
        },
        "quantity": {
            "type": "int",
            "default": 0,
            "isCustom": true
        },
        "totalValue": {
            "type": "currency",
            "isCustom": true
        },
        "licenseExpiry": {
            "notNull": false,
            "type": "date",
            "isCustom": true,
            "useNumericFormat": false
        },
        "serialNumber": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "licenseQuantity": {
            "type": "int",
            "default": 0,
            "isCustom": true
        },
        "quantityUsed": {
            "type": "int",
            "default": 0,
            "isCustom": true
        },
        "quantityRemaining": {
            "type": "int",
            "default": 0,
            "isCustom": true
        },
        "totalValueCurrency": {
            "default": "MAD"
        },
        "purchasePriceCurrency": {
            "default": "MAD"
        },
        "daysRemaining": {
            "type": "int",
            "isCustom": true,
            "readOnly": true
        },
        "licenseStatus": {
            "type": "enum",
            "readOnly": true,
            "options": [
                "Active",
                "Expiring Soon",
                "Expired",
                "No Expiry"
            ],
            "style": {
                "Active": null,
                "Expiring Soon": "warning",
                "Expired": "danger",
                "No Expiry": "success"
            },
            "default": "Active",
            "maxLength": 100,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}